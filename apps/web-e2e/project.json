{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web-e2e",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": ["web"],
  "tags": ["type:e2e"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/task-runner.js test:browser"
      },
      "configurations": {
        "ci": {
          "command": "node scripts/task-runner.js test:browser ci"
        },
        "smoke": {
          "command": "node scripts/task-runner.js test:browser smoke"
        },
        "cross": {
          "command": "node scripts/task-runner.js test:browser cross"
        },
        "headed": {
          "command": "node scripts/task-runner.js test:browser headed"
        },
        "debug": {
          "command": "node scripts/task-runner.js test:browser debug"
        }
      },
      "outputs": ["{workspaceRoot}/apps/web-e2e/playwright-report"]
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["apps/web-e2e/src/**/*.ts"]
      }
    }
  }
}
