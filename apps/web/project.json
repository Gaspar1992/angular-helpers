{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "generators": {},
  "tags": ["type:app"],
  "sourceRoot": "apps/web/src",
  "prefix": "app",
  "targets": {
    "generate-llms": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/generate-llms-txt.mjs"
      }
    },
    "build-workers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["build-workers", "generate-llms", "^build"],
      "outputs": ["{workspaceRoot}/dist/angular-helpers"],
      "options": {
        "outputPath": "dist/angular-helpers",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": ["apps/web/src/styles.css"],
        "server": "apps/web/src/main.server.ts",
        "outputMode": "server",
        "security": {
          "allowedHosts": []
        },
        "ssr": {
          "entry": "apps/web/src/server.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kB",
              "maximumError": "16kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "gh-pages": {
          "baseHref": "/angular-helpers/"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run apps/web/src/app"
      },
      "configurations": {
        "watch": {
          "command": "vitest apps/web/src/app"
        },
        "coverage": {
          "command": "vitest run apps/web/src/app --coverage"
        }
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["apps/web/src/**/*.ts", "apps/web/src/**/*.html"]
      },
      "outputs": ["{options.outputFile}"]
    },
    "ssl-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/task-runner.js ssl:generate"
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "dependsOn": ["ssl-generate"],
      "options": {
        "ssl": true,
        "sslKey": "apps/web/ssl/localhost.key",
        "sslCert": "apps/web/ssl/localhost.crt"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development",
          "prebundle": false
        }
      },
      "defaultConfiguration": "development"
    },
    "generate-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/task-runner.js generate:docs"
      }
    },
    "test-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/task-runner.js test:docs-consistency"
      }
    }
  }
}
