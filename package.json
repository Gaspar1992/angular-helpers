{
  "name": "angular-helpers",
  "version": "1.41.1",
  "type": "module",
  "scripts": {
    "start": "nx serve web",
    "dev": "concurrently \"nx serve web\" \"vite build --watch\"",
    "build": "nx run-many -t build",
    "build:web": "nx build web",
    "build:packages": "nx run-many -t build",
    "build:packages:prod": "nx run-many -t build:prod",
    "test": "nx run-many -t test",
    "test:ci": "vitest run --coverage && nx test @angular-helpers/schematics",
    "test:coverage": "vitest run --coverage && nx test @angular-helpers/schematics",
    "test:watch": "nx run web:test --watch",
    "e2e": "nx e2e web-e2e",
    "e2e:smoke": "nx e2e web-e2e -c smoke",
    "lint": "oxlint . && nx run-many -t lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:package": "nx generate ./dist/libs/schematics/collection.json:create-package",
    "release:check": "node scripts/publish-packages.mjs --dry-run",
    "release:publish": "node scripts/publish-packages.mjs",
    "clean": "node scripts/clean.js",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,js,json,css,html,md}": "oxfmt",
    "*.{ts,js}": "oxlint",
    "*.{ts,html}": "eslint"
  },
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.28.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.4",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@angular/animations": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-server": "catalog:",
    "@angular/router": "catalog:",
    "@angular/ssr": "catalog:",
    "@toon-format/toon": "catalog:",
    "express": "catalog:",
    "highlight.js": "catalog:",
    "marked": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular-devkit/build-angular": "catalog:",
    "@angular-devkit/core": "catalog:",
    "@angular-devkit/schematics": "catalog:",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/platform-browser-dynamic": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@nx/eslint-plugin": "23.2.1",
    "@oxc-project/runtime": "catalog:",
    "@playwright/test": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/npm": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "angular-eslint": "^22.1.0",
    "concurrently": "catalog:",
    "cross-env": "^10.1.0",
    "daisyui": "catalog:",
    "esbuild": "catalog:",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "ng-packagr": "catalog:",
    "nx": "23.2.1",
    "ol": "catalog:",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "proj4": "catalog:",
    "semantic-release": "catalog:",
    "semantic-release-monorepo": "catalog:",
    "seroval": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
