{
  "name": "angular-helpers",
  "version": "1.42.0",
  "type": "module",
  "scripts": {
    "start": "nx serve web",
    "dev": "concurrently \"nx serve web\" \"vite build --watch\"",
    "build": "nx run-many -t build",
    "build:web": "nx build web",
    "build:packages": "nx run-many -t build",
    "build:packages:prod": "nx run-many -t build:prod",
    "test": "nx run-many -t test",
    "test:ci": "vitest run --coverage && nx test @angular-helpers/schematics",
    "test:coverage": "vitest run --coverage && nx test @angular-helpers/schematics",
    "test:watch": "nx run web:test --watch",
    "e2e": "nx e2e web-e2e",
    "e2e:smoke": "nx e2e web-e2e -c smoke",
    "lint": "oxlint . && nx run-many -t lint",
    "lint:packages": "node scripts/lint-packages.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:package": "nx generate ./dist/libs/schematics/collection.json:create-package",
    "generate:llms": "node scripts/generate-llms-txt.mjs",
    "release:check": "node scripts/publish-packages.mjs --dry-run",
    "release:publish": "node scripts/publish-packages.mjs",
    "clean": "node scripts/clean.js",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,js,json,css,html,md}": "oxfmt",
    "*.{ts,js}": "oxlint",
    "*.{ts,html}": "eslint"
  },
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.28.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@angular/animations": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-server": "catalog:",
    "@angular/router": "catalog:",
    "@angular/ssr": "catalog:",
    "@toon-format/toon": "catalog:",
    "express": "catalog:",
    "highlight.js": "catalog:",
    "marked": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular-devkit/build-angular": "catalog:",
    "@angular-devkit/core": "catalog:",
    "@angular-devkit/schematics": "catalog:",
    "@angular-eslint/builder": "catalog:",
    "@angular-eslint/eslint-plugin": "catalog:",
    "@angular-eslint/eslint-plugin-template": "catalog:",
    "@angular-eslint/template-parser": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/platform-browser-dynamic": "catalog:",
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@nx/eslint-plugin": "23.2.1",
    "@oxc-project/runtime": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "angular-eslint": "catalog:",
    "concurrently": "catalog:",
    "cross-env": "^10.1.0",
    "daisyui": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "ng-packagr": "catalog:",
    "nx": "23.2.1",
    "ol": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "proj4": "catalog:",
    "publint": "^0.3.25",
    "seroval": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "web-streams-polyfill": "catalog:",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0"
  }
}
