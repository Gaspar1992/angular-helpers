{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/web/src/main.ts",
    "apps/web/src/main.server.ts",
    "apps/web/src/server.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "apps/web-e2e/playwright.config.ts",
    "scripts/*.js",
    "scripts/*.mjs",
    "scripts/*.ts",
    "apps/web/src/workers/*.ts",
    "**/*.spec.ts"
  ],
  "project": [
    "apps/**/*.ts",
    "libs/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": [
    "@angular-devkit/*",
    "@oxc-project/runtime",
    "vite-tsconfig-paths",
    "web-streams-polyfill",
    "concurrently",
    "daisyui",
    "@tailwindcss/typography"
  ],
  "workspaces": {
    "libs/*": {
      "entry": [
        "src/index.ts",
        "src/public-api.ts",
        "**/src/index.ts",
        "src/workers/*.ts",
        "src/worker/*.ts",
        "src/**/*.spec.ts"
      ],
      "project": ["src/**/*.ts", "**/src/**/*.ts"],
      "ignoreDependencies": ["tslib"]
    },
    "apps/*": {
      "entry": [
        "src/main.ts",
        "src/main.server.ts",
        "src/server.ts",
        "src/workers/*.ts",
        "src/**/*.spec.ts"
      ],
      "project": ["src/**/*.ts"]
    }
  }
}
