{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "vite.config.ts",
        "vitest.config.ts",
        "scripts/*.js",
        "scripts/*.mjs",
        "scripts/*.ts"
      ],
      "project": ["scripts/**/*.js", "scripts/**/*.mjs", "scripts/**/*.ts"],
      "ignoreDependencies": [
        "@analogjs/vitest-angular",
        "@angular-devkit/*",
        "@oxc-project/runtime",
        "@tailwindcss/typography",
        "@toon-format/toon",
        "concurrently",
        "daisyui",
        "seroval",
        "vite-tsconfig-paths",
        "web-streams-polyfill",
        "y-indexeddb",
        "y-websocket"
      ]
    },
    "libs/*": {
      "entry": [
        "src/index.ts",
        "src/public-api.ts",
        "**/src/index.ts",
        "**/src/public-api.ts",
        "src/create-package/index.ts",
        "src/workers/*.ts",
        "src/**/*.spec.ts",
        "test/**/*.spec.ts"
      ],
      "project": ["src/**/*.ts", "**/src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@angular-helpers/testing"]
    },
    "apps/web": {
      "entry": [
        "src/main.ts",
        "src/main.server.ts",
        "src/server.ts",
        "src/workers/*.ts",
        "src/**/*.spec.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web-e2e": {
      "entry": ["playwright.config.ts", "src/**/*.spec.ts"],
      "project": ["**/*.ts"]
    }
  }
}
