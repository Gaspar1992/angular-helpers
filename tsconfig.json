/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "importHelpers": true,
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@angular-helpers/core/utils": ["./libs/core/utils/src/index.ts"],
      "@angular-helpers/storage/worker": ["./libs/storage/worker/src/index.ts"],
      "@angular-helpers/worker-http/transport": ["./libs/worker-http/transport/src/index.ts"],
      "@angular-helpers/worker-http/serializer": ["./libs/worker-http/serializer/src/index.ts"],
      "@angular-helpers/worker-http/backend": ["./libs/worker-http/backend/src/index.ts"],
      "@angular-helpers/worker-http/interceptors": ["./libs/worker-http/interceptors/src/index.ts"],
      "@angular-helpers/worker-http/crypto": ["./libs/worker-http/crypto/src/index.ts"],
      "@angular-helpers/worker-http/realtime": ["./libs/worker-http/realtime/src/index.ts"],
      "@angular-helpers/security/forms": ["./libs/security/forms/src/index.ts"],
      "@angular-helpers/security/signal-forms": ["./libs/security/signal-forms/src/index.ts"],
      "@angular-helpers/browser-web-apis/experimental": [
        "./libs/browser-web-apis/experimental/src/index.ts"
      ],
      "@angular-helpers/openlayers/core": ["./libs/openlayers/core/src/index.ts"],
      "@angular-helpers/openlayers/layers": ["./libs/openlayers/layers/src/index.ts"],
      "@angular-helpers/openlayers/controls": ["./libs/openlayers/controls/src/index.ts"],
      "@angular-helpers/openlayers/interactions": ["./libs/openlayers/interactions/src/index.ts"],
      "@angular-helpers/openlayers/overlays": ["./libs/openlayers/overlays/src/index.ts"],
      "@angular-helpers/*": ["./libs/*/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "strictStandalone": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/web/tsconfig.app.json"
    }
  ]
}
