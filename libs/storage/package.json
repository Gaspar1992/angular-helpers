{
  "name": "@angular-helpers/storage",
  "version": "22.4.1",
  "description": "Reactive Angular storage system with support for Web Storage, IndexedDB, Cache API, TOON compression, and AES-GCM encryption",
  "keywords": [
    "angular",
    "typescript",
    "storage",
    "reactive",
    "indexeddb",
    "cache-api",
    "signals",
    "toon",
    "immutability"
  ],
  "author": "Angular Helpers Team",
  "license": "MIT",
  "homepage": "https://gaspar1992.github.io/angular-helpers/docs/storage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaspar1992/angular-helpers.git",
    "directory": "libs/storage"
  },
  "bugs": {
    "url": "https://github.com/Gaspar1992/angular-helpers/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/storage",
    "build:prod": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/storage",
    "clean": "node ../../scripts/clean.js",
    "test": "vitest run --root ../.. libs/storage",
    "lint": "oxlint src"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "^7.0.0"
  },
  "dependencies": {
    "@angular-helpers/core": "workspace:*",
    "tslib": "catalog:"
  }
}
