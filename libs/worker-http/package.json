{
  "name": "@angular-helpers/worker-http",
  "version": "22.4.0",
  "description": "Angular HTTP over Web Workers — off-main-thread HTTP pipelines with configurable interceptors, WebCrypto security, and pluggable serialization",
  "schematics": "./schematics/collection.json",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/worker-http",
    "build:prod": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/worker-http",
    "build:watch": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json --watch",
    "build:schematics": "tsc -p tsconfig.schematics.json && node scripts/rename-to-cjs.mjs",
    "test": "vitest run --root ../.. libs/worker-http",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "node ../../scripts/clean.js",
    "lint": "oxlint src",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "angular",
    "web-worker",
    "http",
    "off-main-thread",
    "interceptors",
    "webcrypto",
    "hmac",
    "serialization",
    "toon",
    "performance"
  ],
  "homepage": "https://gaspar1992.github.io/angular-helpers/docs/worker-http",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaspar1992/angular-helpers.git",
    "directory": "libs/worker-http"
  },
  "bugs": {
    "url": "https://github.com/Gaspar1992/angular-helpers/issues"
  },
  "sideEffects": false,
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "rxjs": "^7.0.0",
    "seroval": "^1.0.0",
    "@toon-format/toon": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "seroval": {
      "optional": true
    },
    "@toon-format/toon": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "web-streams-polyfill": {
      "optional": true
    }
  },
  "dependencies": {
    "@angular-helpers/core": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular-devkit/core": "catalog:",
    "@angular-devkit/schematics": "catalog:",
    "esbuild": "catalog:",
    "web-streams-polyfill": "catalog:"
  }
}
