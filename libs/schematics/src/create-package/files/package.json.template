{
  "name": "@angular-helpers/<%= name %>",
  "version": "22.0.0",
  "description": "<%= description %>",
  "author": "Angular Helpers Team",
  "license": "MIT",
  "homepage": "https://gaspar1992.github.io/angular-helpers/docs/<%= name %>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaspar1992/angular-helpers.git",
    "directory": "libs/<%= name %>"
  },
  "bugs": {
    "url": "https://github.com/Gaspar1992/angular-helpers/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/<%= name %>",
    "build:prod": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/<%= name %>",
    "clean": "node ../../scripts/clean.js",
    "test": "vitest run --root ../.. libs/<%= name %>",
    "lint": "oxlint src"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0",
    "rxjs": "^7.0.0"
  },
  "dependencies": {
    "tslib": "catalog:"
  }
}
