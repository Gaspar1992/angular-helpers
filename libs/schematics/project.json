{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@angular-helpers/schematics",
  "projectType": "library",
  "sourceRoot": "libs/schematics/src",
  "prefix": "lib",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json && node scripts/rename-to-cjs.mjs",
        "cwd": "libs/schematics"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run -c libs/schematics/test/vitest.schematics.config.ts"
      }
    }
  },
  "tags": ["type:lib", "scope:schematics"]
}
