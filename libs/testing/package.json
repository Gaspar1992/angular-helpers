{
  "name": "@angular-helpers/testing",
  "version": "22.3.0",
  "description": "Streamlined testing utilities for modern Angular applications",
  "keywords": [
    "angular",
    "typescript",
    "testing",
    "vitest",
    "mocks",
    "signals",
    "zoneless"
  ],
  "author": "Angular Helpers Team",
  "license": "MIT",
  "homepage": "https://gaspar1992.github.io/angular-helpers/docs/testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaspar1992/angular-helpers.git",
    "directory": "libs/testing"
  },
  "bugs": {
    "url": "https://github.com/Gaspar1992/angular-helpers/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/testing",
    "build:prod": "ng-packagr -p ng-package.json -c ../../tsconfig.build.json && node ../../scripts/post-build.js ../../dist/testing",
    "clean": "node ../../scripts/clean.js",
    "test": "vitest run --root ../.. libs/testing",
    "lint": "eslint ."
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "^7.0.0 || ^8.0.0",
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
